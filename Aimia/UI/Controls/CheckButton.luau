--!strict
--!optimize 2

--[[
	CheckButton (Godot check_button.cpp, not in reference/engine): a toggle Button with its icon left of its text. The
	icon is a stand-in drawn with Roblox UI, because Godot's toggle_on and toggle_off icons are generated by the
	engine and not baked: a pill with the knob on the right when on and on the left when off, 36 x 20 pixels, tinted by
	button_checked_color or button_unchecked_color (the colors the default theme gives CheckButton). Toggling and the
	toggled signal are the Button's (SceneBuilder).

	DEVIATION(unverified): the icon size and the knob geometry are not Godot's. The disabled icons are not drawn apart:
	the same pieces are used, tinted by the checked or unchecked color.
]]

const Items = require("../Item")
const Style = require("../Style")

type Item = Items.Item

const IconWidth = 36
const IconHeight = 20
const TrackAlpha = 0.35
-- The knob's diameter and its gap to the track's end.
const KnobInset = 2

-- Adds the toggle icon: an empty image label that the text layout places and sizes (the button's icon size), holding the track
-- (a pill) and the knob (a circle).
const function Build(Item: Item)
	const Icon = Instance.new("ImageLabel")
	const Track = Instance.new("Frame")
	const TrackRound = Instance.new("UICorner")
	const Knob = Instance.new("Frame")
	const KnobRound = Instance.new("UICorner")

	Icon.Name = "Icon"
	Icon.BackgroundTransparency = 1
	Icon.ImageTransparency = 1
	Icon.ZIndex = 0
	Track.Name = "Track"
	Track.BorderSizePixel = 0
	Track.Size = UDim2.fromScale(1, 1)
	TrackRound.CornerRadius = UDim.new(0.5, 0)
	TrackRound.Parent = Track
	Track.Parent = Icon
	Knob.Name = "Knob"
	Knob.BorderSizePixel = 0
	Knob.AnchorPoint = Vector2.new(0.5, 0.5)
	Knob.Size = UDim2.fromOffset(IconHeight - 2 * KnobInset, IconHeight - 2 * KnobInset)
	KnobRound.CornerRadius = UDim.new(0.5, 0)
	KnobRound.Parent = Knob
	Knob.Parent = Icon
	Icon.Parent = Item.Instance
	Item.Icon = Icon
	Item.IconSize = vector.create(IconWidth, IconHeight, 0)
	table.insert(Item.Visuals, Icon)
end

-- The icon for the current state, tinted by the state's theme color: the knob moves to the state's end.
const function Draw(Item: Item)
	const Icon = Item.Icon

	if not Icon then
		return
	end

	const Track = Icon:FindFirstChild("Track") :: Frame?
	const Knob = Icon:FindFirstChild("Knob") :: Frame?

	if not Track or not Knob then
		return
	end

	const On = Item.Toggled
	const Color, Transparency = Style.ToColor({ Color = Items.GetColor(Item, if On then "button_checked_color" else "button_unchecked_color") }, Items.OwnModulate(Item))
	const Alpha = 1 - Transparency

	Track.BackgroundColor3 = Color
	Track.BackgroundTransparency = 1 - TrackAlpha * Alpha
	Knob.BackgroundColor3 = Color
	Knob.BackgroundTransparency = Transparency
	Knob.Position = UDim2.new(if On then 1 else 0, if On then -IconHeight / 2 else IconHeight / 2, 0.5, 0)
end

return {
	Build = Build,
	Draw = Draw,
}
